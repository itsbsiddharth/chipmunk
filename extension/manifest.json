{
  "manifest_version": 3,
  "name": "Chipmunk",
  "short_name": "Chipmunk",
  "version": "1.0.0",
  "description": "Collect text, images, links, pages and screenshots from any website into your Chipmunk draft, then send it all to any AI.",
  "key": "",
  "permissions": ["contextMenus", "nativeMessaging", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Chipmunk",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "add-selection": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Add what you selected (or this page) to Chipmunk"
    },
    "screenshot-tab": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Add a screenshot of this tab to Chipmunk"
    }
  }
}
